<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<VBox alignment="CENTER" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.login.Login">
   <children>
      <VBox alignment="CENTER" maxWidth="400.0">
         <children>
            <Label alignment="CENTER" prefHeight="95.0" prefWidth="206.0" text="Login" textAlignment="CENTER">
               <font>
                  <Font name="Noto Sans SignWriting Regular" size="36.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </VBox.margin>
            </Label>
            <VBox>
               <children>
                  <Label text="Username" />
                  <TextField fx:id="usernameField" />
               </children>
               <VBox.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </VBox.margin>
            </VBox>
            <VBox>
               <children>
                  <Label text="Password" />
                  <PasswordField fx:id="passwordField" />
               </children>
               <VBox.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </VBox.margin>
            </VBox>
            <HBox>
               <children>
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#exit" prefHeight="63.0" prefWidth="102.0" text="Exit">
                     <font>
                        <Font size="29.0" />
                     </font>
                  </Button>
                  <Region minWidth="-Infinity" prefHeight="0.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#login" prefHeight="63.0" prefWidth="102.0" text="Login">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>
