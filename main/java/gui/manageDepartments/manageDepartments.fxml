<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="550.0" prefWidth="750.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.manageDepartments.manageDepartmentsController">
    <children>
        <Label layoutX="14.0" layoutY="12.0" text="Manage Departments">
            <font>
                <Font name="System Bold" size="27.0" />
            </font>
        </Label>
        <Label layoutX="423.0" layoutY="51.0" prefHeight="35.0" prefWidth="89.0" text="Search: ">
            <font>
                <Font name="System Italic" size="25.0" />
            </font>
        </Label>
        <TextField fx:id="departmentNameField" layoutX="512.0" layoutY="51.0" prefHeight="35.0" prefWidth="220.0" style="-fx-border-color: #00a8ff; -fx-border-width: 3; -fx-background-color: white;" />
        <TableView fx:id="tableView" layoutX="14.0" layoutY="117.0" prefHeight="290.0" prefWidth="721.0" style="-fx-border-color: black; -fx-border-width: 2; -fx-background-color: white;">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="75.0" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="75.0" text="Name" />
            <TableColumn fx:id="numberOfEmployeesColumn" prefWidth="75.0" text="Number of Employees" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER" layoutX="25.0" layoutY="422.0" prefHeight="100.0" prefWidth="700.0" spacing="100.0" style="-fx-background-color: white;">
            <children>
                <Button mnemonicParsing="false" onAction="#back" prefHeight="45.0" prefWidth="125.0" style="-fx-background-color: white; -fx-border-color: grey; -fx-border-width: 3;" text="Back">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#addDepartment" prefHeight="45.0" prefWidth="125.0" style="-fx-background-color: white; -fx-border-color: green; -fx-border-width: 3;" text="Add">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#delete" prefHeight="45.0" prefWidth="125.0" style="-fx-background-color: white; -fx-border-color: red; -fx-border-width: 3;" text="Delete">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#editDepartment" prefHeight="45.0" prefWidth="125.0" style="-fx-background-color: white; -fx-border-color: grey; -fx-border-width: 3;" text="Edit">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
</AnchorPane>
