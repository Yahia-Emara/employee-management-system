         <children>
            <Button alignment="CENTER" mnemonicParsing="false" onAction="#addEmployee" prefHeight="100.0" prefWidth="180.0" style="-fx-border-color: green; -fx-border-width: 4; -fx-background-color: white;" text="Add Employee" wrapText="true">
